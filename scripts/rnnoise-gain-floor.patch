+/* rgoclient: not in xiph's API. See the gain_floor field. */
+void rnnoise_set_gain_floor(DenoiseState *st, float gain_floor) {
+  if (gain_floor < 0) gain_floor = 0;
+  if (gain_floor > 1) gain_floor = 1;
+  st->gain_floor = gain_floor;
+}
